# Copy to .env (ignored). Never commit actual keys.
DART_API_KEY=
# SSAFY GMS key for F2003 LLM calls; local embeddings do not use this key.
OPENAI_API_KEY=
# Cloud-compatible alias; when both are set GMS_API_KEY takes precedence.
GMS_API_KEY=
DART_DATA_DIR=.local/data
DART_TIMEOUT_SECONDS=20
DART_REQUEST_INTERVAL_SECONDS=0.3
DART_CORP_CACHE_TTL_SECONDS=86400
DART_LIST_CACHE_TTL_SECONDS=900
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
OPENAI_CHAT_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
# Optional; defaults to DART_DATA_DIR/models.
EMBEDDING_CACHE_DIR=
# Existing local BGE-M3 metadata DB. Relative paths are resolved from repository root.
CHROMA_DB_DIR=.local/data/chroma_bge_m3
CANDIDATE_TOP_K=5
DOCUMENT_SEARCH_DAYS=366
# Optional actual OpenDART text bundle JSON, instead of online document collection.
DOCUMENT_BUNDLE=
