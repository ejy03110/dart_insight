# Copy to .env (ignored). Never commit actual keys.
DART_API_KEY=
# Reserved for later LLM integration; local embeddings do not use this key.
OPENAI_API_KEY=
DART_DATA_DIR=.local/data
DART_TIMEOUT_SECONDS=20
DART_REQUEST_INTERVAL_SECONDS=0.3
DART_CORP_CACHE_TTL_SECONDS=86400
DART_LIST_CACHE_TTL_SECONDS=900
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
OPENAI_CHAT_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
# Optional; defaults to DART_DATA_DIR/models.
EMBEDDING_CACHE_DIR=
